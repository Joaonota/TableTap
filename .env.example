# TapMenu — variáveis de ambiente (frontend)
#
# Copie para .env.local (ignorado pelo git) e preencha.
# Supabase → Project Settings → API Keys.
#
# Use APENAS a chave pública (publishable / anon). A chave service_role
# (ou "secret") ignora todas as regras de segurança e NUNCA pode estar no
# frontend — a aplicação recusa arrancar se a detetar.

VITE_SUPABASE_URL=https://<projeto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

VITE_APP_TITLE=TapMenu

# Base pública usada para construir os URLs gravados nas etiquetas NFC e QR
# Codes (opcional). Em produção: o domínio HTTPS público (ex.: https://app.tapmenu.co.mz).
VITE_PUBLIC_BASE_URL=
